        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record model="ir.model.access" id="fastapi_endpoint_router_option_access_view">
        <field name="name">fastapi.endpoint_router_option view</field>
        <field name="model_id" ref="model_fastapi_endpoint_router_option" />
        <field name="group_id" ref="fastapi.group_fastapi_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record model="ir.model.access" id="fastapi_endpoint_router_option_access_manage">
        <field name="name">fastapi.endpoint_router_option manage</field>
        <field name="model_id" ref="model_fastapi_endpoint_router_option" />
