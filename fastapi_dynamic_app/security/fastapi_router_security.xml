<odoo>

    <record model="ir.model.access" id="fastapi_router_access_view">
        <field name="name">fastapi.router view</field>
        <field name="model_id" ref="model_fastapi_router" />
        <field name="group_id" ref="fastapi.group_fastapi_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record model="ir.model.access" id="fastapi_router_access_manage">
        <field name="name">fastapi.router manage</field>
        <field name="model_id" ref="model_fastapi_router" />
        <field name="group_id" ref="fastapi.group_fastapi_manager" />
