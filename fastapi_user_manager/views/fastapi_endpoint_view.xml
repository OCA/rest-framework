<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="fastapi_endpoint_apiadd_form_view">
        <field name="name">fastapi.endpoint.apiadd.form (in fastapi)</field>
        <field name="model">fastapi.endpoint</field>
        <field name="inherit_id" ref="fastapi.fastapi_endpoint_form_view" />
        <field name="arch" type="xml">
            <span name="configuration" position="after">
                <group
                    name="apiadd_app_configuration"
                    title="Configuration"
                    invisible="app != 'user_manager'"
                >
                    <field name="auth_method" />
                </group>
            </span>
        </field>
    </record>
</odoo>
