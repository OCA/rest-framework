<odoo>
    <record id="res_user_view_form" model="ir.ui.view">
        <field name="name">fastapi.user.form.</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Authentification Api_key">
                    <group
                        name="api_key_app_configuration"
                        title="Configuration api key"
                    >
                        <field name="api_key_user" />
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
