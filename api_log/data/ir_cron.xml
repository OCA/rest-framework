<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="cron_delete_api_log" model="ir.cron">
        <field name="name">API Log: Delete old logs</field>
        <field name="model_id" ref="model_api_log" />
        <field name="active" eval="False" />
        <field name="doall" eval="False" />
        <field name="state">code</field>
        <field name="code">model.cron_delete_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field
            name="nextcall"
            eval="(DateTime.today() + relativedelta(day=1)).strftime('%Y-%m-%d')"
        />
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root" />
    </record>
</odoo>
